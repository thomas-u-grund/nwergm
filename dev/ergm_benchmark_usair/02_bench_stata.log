> 
>         pij = G.shared_partners_rtp(i,j)
>         chg = delta * gw_kernel(pij, td.decay)
> 
>         if (!G.has_edge(j,i)) return(chg)       // toggling i->j only changes the
>                                                 // mutual-tie graph (and so only
>                                                 // affects OTHER dyads) when j->i
>                                                 // already exists
> 
>         nb = G.mutual_neighbors(j)
>         for (m=1; m<=cols(nb); m++) {
