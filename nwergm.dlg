PROGRAM command
BEGIN
	put "nwergm " main.cb_net
	beginoptions
		put /program o_plain1
		put /program o_plain2
		put /program o_plain3
		put /program o_plain4
		put /program o_plain5
		put /program o_plain6
		put /program o_plain7
		if main.cx_density | main.cx_meandeg | main.cx_twopath | main.cx_isolates | main.cx_isolatededges | deg.cx_s_degree | ///
			deg.cx_s_odegree | deg.cx_s_idegree | deg.cx_s_degrange | deg.cx_s_odegrange | deg.cx_s_idegrange | deg.cx_s_kstar | ///
			deg.cx_s_ostar | deg.cx_s_istar | deg.cx_s_concurrent | deg.cx_concurrentties | deg.cx_degree1_5 | deg.cx_odegree1_5 | ///
			deg.cx_idegree1_5 | deg.cx_degcrossprod | deg.cx_degcor | deg.cx_m2star | tri.cx_s_triangle | tri.cx_transitive | ///
			tri.cx_intransitive | tri.cx_ttriple | tri.cx_s_ctriple | tri.cx_cycle | tri.cx_threetrail | tri.cx_balance | ///
			tri.cx_triadcensus | tri.cx_tripercent | tri.cx_nearsimmelian | tri.cx_simmelian | tri.cx_simmelianties | ///
			tri.cx_asymmetric | tri.cx_s_mutual | tri.cx_localtriangle | tri.cx_opentriad | tri.cx_nsp | tri.cx_s_altkstar {
			put " structural("
			put /program o_struct1
			put /program o_struct2
			put /program o_struct3
			put /program o_struct4
			put /program o_struct5
			put ")"
		}
		if oper.cx_op_sum | oper.cx_op_prod | oper.cx_op_s | oper.cx_op_f | oper.cx_op_nmf | oper.cx_op_sym | oper.cx_op_proj | ///
			oper.cx_op_i | oper.cx_op_for | oper.cx_op_label | oper.cx_op_log | oper.cx_op_exp | oper.cx_op_curve | ///
			oper.cx_op_offset | oper.f_operators_extra {
			put " operators("
			put /program o_oper1
			put /program o_oper2
			put ")"
		}
		if cons.cx_c_edges | cons.cx_c_degrees | cons.cx_c_odegrees | cons.cx_c_idegrees | cons.cx_c_b1degrees | ///
			cons.cx_c_b2degrees | cons.cx_c_degreedist | cons.cx_c_idegreedist | cons.cx_c_bd | cons.cx_c_blocks | ///
			cons.cx_c_blockdiag | cons.cx_c_fixedas | cons.cx_c_fixallbut | cons.cx_c_observed | cons.cx_c_egocentric | ///
			cons.cx_c_dyadnoise | cons.f_constraints_extra {
			put " constraints("
			put /program o_con_1
			put /program o_con_2
			put ")"
		}
		if cons.o_cx_c_edges | cons.o_cx_c_degrees | cons.o_cx_c_odegrees | cons.o_cx_c_idegrees | cons.o_cx_c_b1degrees | ///
			cons.o_cx_c_b2degrees | cons.o_cx_c_degreedist | cons.o_cx_c_idegreedist | cons.o_cx_c_bd | cons.o_cx_c_blocks | ///
			cons.o_cx_c_blockdiag | cons.o_cx_c_fixedas | cons.o_cx_c_fixallbut | cons.o_cx_c_observed | cons.o_cx_c_egocentric | ///
			cons.o_cx_c_dyadnoise | cons.f_obsconstraints_extra {
			put " obsconstraints("
			put /program o_obs_1
			put /program o_obs_2
			put ")"
		}
	endoptions
	stata
END
