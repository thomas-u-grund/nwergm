PROGRAM initialize
BEGIN
	put "_nwdialog nwergm"
	stata hidden immediate
END

PROGRAM o_plain1
BEGIN
	if main.cx_edges {
		put " edges"
	}
	if main.cx_mutual {
		put " mutual"
	}
	if main.cx_triangle {
		put " triangle"
	}
	if main.cx_ctriple {
		put " ctriple"
	}
	if main.cx_transitiveties {
		put " transitiveties"
	}
	if main.cx_cyclicalties {
		put " cyclicalties"
	}
	if main.cx_concurrent {
		put " concurrent"
	}
	if main.cx_sender {
		put " sender"
	}
	if main.cx_receiver {
		put " receiver"
	}
	if deg.cx_degree {
		require deg.f_degree
		put " degree(" deg.f_degree
		put ")"
	}
	if deg.cx_odegree {
		require deg.f_odegree
		put " odegree(" deg.f_odegree
		put ")"
	}
	if deg.cx_idegree {
		require deg.f_idegree
		put " idegree(" deg.f_idegree
		put ")"
	}
	if deg.cx_kstar {
		require deg.f_kstar
		put " kstar(" deg.f_kstar
		put ")"
	}
	if deg.cx_ostar {
		require deg.f_ostar
		put " ostar(" deg.f_ostar
		put ")"
	}
	if deg.cx_istar {
		require deg.f_istar
		put " istar(" deg.f_istar
		put ")"
	}
	if deg.cx_degrange {
		require deg.f_degrange
		put " degrange(" deg.f_degrange
		put ")"
		if deg.f_degrange_to {
			put " degrangeto(" deg.f_degrange_to ")"
		}
	}
	if deg.cx_odegrange {
		require deg.f_odegrange
		put " odegrange(" deg.f_odegrange
		put ")"
		if deg.f_odegrange_to {
			put " odegrangeto(" deg.f_odegrange_to ")"
		}
	}
	if deg.cx_idegrange {
		require deg.f_idegrange
		put " idegrange(" deg.f_idegrange
		put ")"
		if deg.f_idegrange_to {
			put " idegrangeto(" deg.f_idegrange_to ")"
		}
	}
	if tri.cx_esp {
		require tri.f_esp
		put " esp(" tri.f_esp
		put ")"
	}
	if tri.cx_dsp {
		require tri.f_dsp
		put " dsp(" tri.f_dsp
		put ")"
	}
	if cov.cx_nodecov {
		require cov.f_nodecov
		put " nodecov(" cov.f_nodecov
		if cov.f_nodecov_sub {
			put ", " cov.f_nodecov_sub
		}
		put ")"
	}
	if cov.cx_nodeicov {
		require cov.f_nodeicov
		put " nodeicov(" cov.f_nodeicov
		if cov.f_nodeicov_sub {
			put ", " cov.f_nodeicov_sub
		}
		put ")"
	}
END

