DIALOG main, label("nwergm - Exponential random graph models (ERGM)") tabtitle("Basic")
BEGIN
  TEXT      tx_net 10 12 120 ., label("Network:")
  COMBOBOX  cb_net 140 10 220 ., dropdown contents(netlist) nomem
  TEXT      tx_s31_main 10 33 960 ., label("== Required term ==")
  CHECKBOX  cx_edges 10 52 190 ., label("edges") default(1) nomem
  TEXT      tx_h1 208 54 777 ., label("required (intercept); may be omitted only with density or meandeg")
  TEXT      tx_s73_main 10 75 960 ., label("== Reciprocity, triangles, concurrency ==")
  CHECKBOX  cx_mutual 10 94 190 ., label("mutual") default(0) nomem
  TEXT      tx_h2 208 96 777 ., label("directed only")
  CHECKBOX  cx_triangle 10 115 190 ., label("triangle") default(0) nomem
  TEXT      tx_h3 208 117 777 ., label("undirected only (R: triangle)")
  CHECKBOX  cx_ctriple 10 136 190 ., label("ctriple") default(0) nomem
  TEXT      tx_h4 208 138 777 ., label("directed only (cyclic triples)")
  CHECKBOX  cx_transitiveties 10 157 190 ., label("transitiveties") default(0) nomem
  TEXT      tx_h5 208 159 777 ., label("directed only")
  CHECKBOX  cx_cyclicalties 10 178 190 ., label("cyclicalties") default(0) nomem
  TEXT      tx_h6 208 180 777 ., label("directed only")
  CHECKBOX  cx_concurrent 10 199 190 ., label("concurrent") default(0) nomem
  TEXT      tx_h7 208 201 777 ., label("undirected only (degree 2 or more)")
  TEXT      tx_s220_main 10 222 960 ., label("== Node-level effects ==")
  CHECKBOX  cx_sender 10 241 190 ., label("sender") default(0) nomem
  TEXT      tx_h8 208 243 777 ., label("directed only; one coefficient per node (out-degree)")
  CHECKBOX  cx_receiver 10 262 190 ., label("receiver") default(0) nomem
  TEXT      tx_h9 208 264 777 ., label("directed only; one coefficient per node (in-degree)")
  TEXT      tx_s283_main 10 285 960 ., label("== Simple structural() terms (need the native plugin) ==")
  CHECKBOX  cx_density 10 304 190 ., label("density") default(0) nomem
  TEXT      tx_h10 208 306 777 ., label("structural(); collinear with edges")
  CHECKBOX  cx_meandeg 10 325 190 ., label("meandeg") default(0) nomem
  TEXT      tx_h11 208 327 777 ., label("structural(); collinear with edges")
  CHECKBOX  cx_twopath 10 346 190 ., label("twopath") default(0) nomem
  TEXT      tx_h12 208 348 777 ., label("structural(): two-paths")
  CHECKBOX  cx_isolates 10 367 190 ., label("isolates") default(0) nomem
  TEXT      tx_h13 208 369 777 ., label("structural(): isolated nodes")
  CHECKBOX  cx_isolatededges 10 388 190 ., label("isolatededges") default(0) nomem
  TEXT      tx_h14 208 390 777 ., label("structural(), undirected only")
END

