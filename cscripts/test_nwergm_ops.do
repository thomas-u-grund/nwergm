* The core package nwcommands is found through the environment variable NWCORE (path of the core checkout).
local nwcore : env NWCORE
if `"`nwcore'"' == "" {
	di as error "set the environment variable NWCORE to the directory of the nwcommands (core) package"
	exit 198
}
adopath ++ `"`nwcore'"'
adopath ++ `"`c(pwd)'"'
quietly do `"`nwcore'/unw_core.do"'
do unw_ergm.do
capture adopath ++ "lib/plugins/macos"
capture adopath ++ "lib/plugins/unix"
capture adopath ++ "lib/plugins/windows"

* Certifies the operator terms of nwergm's operators() option against R ergm 4.12.0:
*  (1) the observed statistics of `edges + operator' equal summary() of the same formula,
*  (2) the MPLE coefficients and standard errors equal ergm(estimate = "MPLE"),
*  (3) the MCMLE coefficients are within Monte Carlo noise of R's, for two seeds.
* Networks: random undirected (40 nodes), Florentine marriages, Faux Mesa High; random directed (30), Sampson's monks;
* random bipartite (12 x 18), Davis' southern women. Reference values: dev/gen_test_ops.R (this file is generated by it).

capture program drop ops_net
program ops_net
	// ops_net name kind n "edge list" [n1]: kind is und, dir or bip; the edge list is i j i j ... (bipartite: person event)
	args name kind n edges n1
	nwclear
	if "`kind'" == "bip" {
		local n2 = `n' - `n1'
		matrix __A = J(`n2', `n1', 0)
		local k : word count `edges'
		forvalues t = 1(2)`k' {
			local i : word `t' of `edges'
			local j : word `=`t'+1' of `edges'
			matrix __A[`j', `i'] = 1
		}
		nwset, mat(__A) bipartite name(`name') nooutput
		clear
		set obs `n'
	}
	else {
		matrix __A = J(`n', `n', 0)
		local k : word count `edges'
		forvalues t = 1(2)`k' {
			local i : word `t' of `edges'
			local j : word `=`t'+1' of `edges'
			matrix __A[`i', `j'] = 1
			if "`kind'" == "und" matrix __A[`j', `i'] = 1
		}
		nwset, mat(__A) `=cond("`kind'"=="und","undirected","directed")' name(`name') nooutput
	}
end

capture program drop ops_var
program ops_var
	args v values
	capture drop `v'
	qui gen double `v' = .
	local k = 0
	foreach x of local values {
		local ++k
		qui replace `v' = `x' in `k'
	}
end

capture program drop ops_check
program ops_check
	// ops_check net id "operators" "stats" "coefs" "ses" [tolerance of the statistics]
	// (R computes Prod as Exp(Sum(Log)) with the value -1/sqrt(eps) for log(0), which limits the precision of its Prod statistics to about 1e-8)
	args net id ops stats coefs ses tol
	if "`tol'" == "" local tol 1e-8
	qui nwergm `net', edges operators(`ops') method(mple)
	mata: st_matrix("__ops_S", __nwergm_last_M.full_statistic(__nwergm_last_G))
	local p : word count `stats'
	assert colsof(__ops_S) == `p'
	assert colsof(e(b)) == `p'
	forvalues j = 1/`p' {
		local e : word `j' of `stats'
		if abs(__ops_S[1,`j'] - `e') > `tol' * max(1, abs(`e')) {
			di as err "FAIL statistic `net' `id': term `j' is " __ops_S[1,`j'] " but R gives `e'"
			exit 9
		}
	}
	tempname b V
	matrix `b' = e(b)
	matrix `V' = e(V)
	local dmax 0
	forvalues j = 1/`p' {
		local e : word `j' of `coefs'
		local s : word `j' of `ses'
		if "`e'" == "NA" {
			assert `b'[1,`j'] == 0
			continue
		}
		local d1 = abs(`b'[1,`j'] - `e')
		local d2 = abs(sqrt(`V'[`j',`j']) - `s')
		if `d1' > 1e-4 * max(1, abs(`e')) | `d2' > 1e-4 * max(1, `s') {
			di as err "FAIL MPLE `net' `id': coefficient `j' is " `b'[1,`j'] " (R `e'), se " sqrt(`V'[`j',`j']) " (R `s')"
			exit 9
		}
		local dmax = max(`dmax', `d1', `d2')
	}
	di "PASS `net' `id': statistics exact, MPLE max difference " %9.2e `dmax'
end

capture program drop ops_check_off
program ops_check_off
	// as ops_check, for a model with one fixed coefficient: R reports only the free coefficients
	args net id ops stats coefs ses fpos fval
	qui nwergm `net', edges operators(`ops') method(mple)
	mata: st_matrix("__ops_S", __nwergm_last_M.full_statistic(__nwergm_last_G))
	local p : word count `stats'
	forvalues j = 1/`p' {
		local e : word `j' of `stats'
		assert abs(__ops_S[1,`j'] - `e') <= 1e-8 * max(1, abs(`e'))
	}
	tempname b V
	matrix `b' = e(b)
	matrix `V' = e(V)
	local k = 0
	local dmax 0
	forvalues j = 1/`p' {
		if `j' == `fpos' {
			assert abs(`b'[1,`j'] - `fval') < 1e-12
			continue
		}
		local ++k
		local e : word `k' of `coefs'
		local s : word `k' of `ses'
		local d1 = abs(`b'[1,`j'] - `e')
		local d2 = abs(sqrt(`V'[`j',`j']) - `s')
		if `d1' > 1e-4 * max(1, abs(`e')) | `d2' > 1e-4 * max(1, `s') {
			di as err "FAIL MPLE `net' `id': coefficient `j' is " `b'[1,`j'] " (R `e'), se " sqrt(`V'[`j',`j']) " (R `s')"
			exit 9
		}
		local dmax = max(`dmax', `d1', `d2')
	}
	di "PASS `net' `id': statistics exact, MPLE max difference " %9.2e `dmax'
end

capture program drop ops_mcmle
program ops_mcmle
	// ops_mcmle net id "operators" "coefs" "ses"
	args net id ops coefs ses
	foreach sd in 101 202 {
		set seed `sd'
		qui nwergm `net', edges operators(`ops') method(mcmle) mcmcsamplesize(4000) mcmcinterval(500) mcmcburnin(20000) mcmleiterations(40)
		assert e(converged) == 1
		tempname b
		matrix `b' = e(b)
		local p = colsof(`b')
		forvalues j = 1/`p' {
			local e : word `j' of `coefs'
			local s : word `j' of `ses'
			if abs(`b'[1,`j'] - `e') > 3.5 * `s' {
				di as err "FAIL MCMLE `net' `id' seed `sd': coefficient `j' is " `b'[1,`j'] " but R gives `e' (se `s')"
				exit 9
			}
		}
	}
	di "PASS `net' `id': MCMLE within Monte Carlo noise of R for two seeds"
end

