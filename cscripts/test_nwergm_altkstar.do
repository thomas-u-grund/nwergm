capture program drop ak_net
program ak_net
	args name n edges
	nwclear
	matrix __A = J(`n', `n', 0)
	local k : word count `edges'
	forvalues t = 1(2)`k' {
		local i : word `t' of `edges'
		local j : word `=`t'+1' of `edges'
		matrix __A[`i', `j'] = 1
		matrix __A[`j', `i'] = 1
	}
	nwset, mat(__A) undirected name(`name') nooutput
end

capture program drop ak_mple
program ak_mple
	args net init coefs ses opt
	if "`opt'" == "" local opt "structural(altkstar)"
	qui nwergm `net', edges `opt' method(mple) init(`init')
	tempname b V
	matrix `b' = e(b)
	matrix `V' = e(V)
	local dmax 0
	forvalues j = 1/3 {
		local e : word `j' of `coefs'
		local s : word `j' of `ses'
		local d1 = abs(`b'[1,`j'] - `e')
		local d2 = abs(sqrt(`V'[`j',`j']) - `s')
		if `d1' > 1e-3 * max(1, abs(`e')) | `d2' > 1e-3 * max(1, `s') {
			di as err "FAIL altkstar `net' init(`init'): coefficient `j' is " `b'[1,`j'] " (R `e'), se " sqrt(`V'[`j',`j']) " (R `s')"
			exit 9
		}
		local dmax = max(`dmax', `d1', `d2')
	}
	di "PASS altkstar `net' init(`init'): MPLE max difference to R " %9.2e `dmax'
end

