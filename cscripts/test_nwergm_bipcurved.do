cscript

capture adopath ++ "."
capture adopath ++ "lib"
* The core package nwcommands is found through the environment variable NWCORE (path of the core checkout).
local nwcore : env NWCORE
if `"`nwcore'"' == "" {
	di as error "set the environment variable NWCORE to the directory of the nwcommands (core) package"
	exit 198
}
adopath ++ `"`nwcore'"'
adopath ++ `"`c(pwd)'"'
quietly do `"`nwcore'/unw_core.do"'
do unw_ergm.do
capture adopath ++ "lib/plugins/macos"
capture adopath ++ "lib/plugins/unix"
capture adopath ++ "lib/plugins/windows"

* Certifies the curved (estimated decay) two-mode terms gwb1degree, gwb2degree, gwb1dsp, gwb2dsp against R ergm 4.12.0:
*  (1) MPLE coefficients (edges, weight, decay) and standard errors equal ergm(estimate = "MPLE"),
*  (2) the MCMLE coefficients are within Monte Carlo noise of R's for two seeds.
* Reference values: dev/gen_test_bipcurved.R (this file is generated by it).

capture program drop bc_net
program bc_net
	// bc_net name n1 n2 "person event person event ..."
	args name n1 n2 edges
	nwclear
	matrix __A = J(`n2', `n1', 0)
	local k : word count `edges'
	forvalues t = 1(2)`k' {
		local i : word `t' of `edges'
		local j : word `=`t'+1' of `edges'
		matrix __A[`j', `i'] = 1
	}
	nwset, mat(__A) bipartite name(`name') nooutput
	clear
	set obs `=`n1'+`n2''
end

capture program drop bc_mple
program bc_mple
	// bc_mple net option "coefs" "ses"
	args net opt coefs ses
	qui nwergm `net', edges `opt'(0.5) method(mple)
	tempname b V
	matrix `b' = e(b)
	matrix `V' = e(V)
	local dmax 0
	forvalues j = 1/3 {
		local e : word `j' of `coefs'
		local s : word `j' of `ses'
		local d1 = abs(`b'[1,`j'] - `e')
		local d2 = abs(sqrt(`V'[`j',`j']) - `s')
		if `d1' > 1e-3 * max(1, abs(`e')) | `d2' > 1e-3 * max(1, `s') {
			di as err "FAIL MPLE `net' `opt': coefficient `j' is " `b'[1,`j'] " (R `e'), se " sqrt(`V'[`j',`j']) " (R `s')"
			exit 9
		}
		local dmax = max(`dmax', `d1', `d2')
	}
	di "PASS `net' `opt': MPLE max difference to R " %9.2e `dmax'
end

capture program drop bc_mcmle
program bc_mcmle
	args net opt coefs ses
	foreach sd in 101 202 {
		set seed `sd'
		qui nwergm `net', edges `opt'(0.5) method(mcmle) mcmcsamplesize(2000) mcmcinterval(100) mcmcburnin(5000) mcmleiterations(25) nologlik
		tempname b
		matrix `b' = e(b)
		forvalues j = 1/3 {
			local e : word `j' of `coefs'
			local s : word `j' of `ses'
			if abs(`b'[1,`j'] - `e') > 3.5 * `s' {
				di as err "FAIL MCMLE `net' `opt' seed `sd': coefficient `j' is " `b'[1,`j'] " but R gives `e' (se `s')"
				exit 9
			}
		}
	}
	di "PASS `net' `opt': MCMLE within Monte Carlo noise of R for two seeds"
end

