/* nwergm_estat.dlg - generated by dlg/gen_dialogs.py from dlg/nwergm_dialog_spec.py; do not edit by hand. */
VERSION 14.0
SYNCHRONOUS_ONLY

INCLUDE _std_xxwide
DEFINE _dlgwd 1000
DEFINE _dlght 540
INCLUDE header

HELP hlp1, view("help nwergm_estat")
RESET res1

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG main, label("nwergm - postestimation (gof, MCMC diagnostics, information criteria, simulation)") tabtitle("Command")
BEGIN
  TEXT      tx_which 10 12 120 ., label("Run:")
  COMBOBOX  cb_which 140 10 380 ., dropdownlist contents(l_which) values(l_which_v) nomem
  TEXT      tx_n31_main 10 33 960 ., label("These commands work on the last model fitted with nwergm (they need the fitted model in memory).")
  TEXT      tx_n52_main 10 54 960 ., label("Choose the command above, then set its options on the tab with the same name and press OK.")
  TEXT      tx_n73_main 10 75 960 ., label("estat gof / mcmcdiag / ic are postestimation commands; the last choice draws networks from the fit.")
END

DIALOG gof, tabtitle("GOF")
BEGIN
  TEXT      tx_g_nsim 10 12 200 ., label("nsim()")
  EDIT      f_g_nsim 215 10 110 ., option(nsim) nomem
  TEXT      tx_h1 335 12 650 ., label("simulated networks; default 100")
  TEXT      tx_g_seed 10 33 200 ., label("seed()")
  EDIT      f_g_seed 215 31 110 ., option(seed) nomem
  TEXT      tx_h2 335 33 650 ., label("random-number seed")
  TEXT      tx_g_burnin 10 54 200 ., label("gofburnin()")
  EDIT      f_g_burnin 215 52 110 ., option(gofburnin) nomem
  TEXT      tx_h3 335 54 650 ., label("default: burn-in of the fit")
  TEXT      tx_g_interval 10 75 200 ., label("gofinterval()")
  EDIT      f_g_interval 215 73 110 ., option(gofinterval) nomem
  TEXT      tx_h4 335 75 650 ., label("default: interval of the fit")
  TEXT      tx_g_maxdeg 10 96 200 ., label("maxdeg()")
  EDIT      f_g_maxdeg 215 94 110 ., option(maxdeg) nomem
  TEXT      tx_h5 335 96 650 ., label("largest degree plotted; default 15")
  TEXT      tx_g_maxdist 10 117 200 ., label("maxdist()")
  EDIT      f_g_maxdist 215 115 110 ., option(maxdist) nomem
  TEXT      tx_h6 335 117 650 ., label("largest distance plotted; default 6")
  TEXT      tx_g_name 10 138 200 ., label("name()")
  EDIT      f_g_name 215 136 110 ., option(name) nomem
  TEXT      tx_h7 335 138 650 ., label("name of the graph")
  CHECKBOX  f_g_plot 10 157 200 ., label("plot") default(0) nomem
  TEXT      tx_h8 220 159 765 ., label("draw the comparison graphs")
  TEXT      tx_s178_gof 10 180 960 ., label("== gof(): statistics to compare (none ticked = the default for the network type) ==")
  CHECKBOX  cx_gof_degree 10 199 280 ., label("degree") default(0) nomem
  CHECKBOX  cx_gof_espartners 310 199 280 ., label("espartners") default(0) nomem
  CHECKBOX  cx_gof_idegree 10 220 280 ., label("idegree") default(0) nomem
  CHECKBOX  cx_gof_dspartners 310 220 280 ., label("dspartners") default(0) nomem
  CHECKBOX  cx_gof_odegree 10 241 280 ., label("odegree") default(0) nomem
  CHECKBOX  cx_gof_distance 310 241 280 ., label("distance") default(0) nomem
  CHECKBOX  cx_gof_b1degree 10 262 280 ., label("b1degree") default(0) nomem
  CHECKBOX  cx_gof_triadcensus 310 262 280 ., label("triadcensus") default(0) nomem
  CHECKBOX  cx_gof_b2degree 10 283 280 ., label("b2degree") default(0) nomem
  CHECKBOX  cx_gof_model 310 283 280 ., label("model") default(0) nomem
  CHECKBOX  cx_gof_dropmodel 10 304 560 ., label("drop the model statistics (writes -model; use with 'model' unticked)") default(0) nomem
END

DIALOG mcmcdiag, tabtitle("MCMC")
BEGIN
  TEXT      tx_m_pvalue 10 12 200 ., label("pvalue()")
  COMBOBOX  f_m_pvalue 215 10 100 ., dropdownlist contents(l_f_m_pvalue) values(l_f_m_pvalue_v) option(pvalue) nomem
  TEXT      tx_h9 325 12 660 ., label("level of the stationarity test")
  TEXT      tx_m_eps 10 33 200 ., label("eps()")
  EDIT      f_m_eps 215 31 110 ., option(eps) nomem
  TEXT      tx_h10 335 33 650 ., label("half-width tolerance; default 0.1")
  TEXT      tx_m_name 10 54 200 ., label("name()")
  EDIT      f_m_name 215 52 110 ., option(name) nomem
  TEXT      tx_h11 335 54 650 ., label("name of the combined graph")
  CHECKBOX  f_m_plot 10 73 200 ., label("plot") default(0) nomem
  TEXT      tx_h12 220 75 765 ., label("trace and density plots")
END

DIALOG ic, tabtitle("IC")
BEGIN
  TEXT      tx_n10_ic 10 12 960 ., label("estat ic reports the log-likelihood, AIC and BIC of the last nwergm fit. It has no options.")
END

DIALOG simfit, tabtitle("Simulate")
BEGIN
  TEXT      tx_s_nsim 10 12 200 ., label("nsim()")
  EDIT      f_s_nsim 215 10 110 ., option(nsim) nomem
  TEXT      tx_h13 335 12 650 ., label("default 1")
  TEXT      tx_s_seed 10 33 200 ., label("seed()")
  EDIT      f_s_seed 215 31 110 ., option(seed) nomem
  TEXT      tx_s_output 10 54 200 ., label("output()")
  COMBOBOX  f_s_output 215 52 100 ., dropdownlist contents(l_f_s_output) values(l_f_s_output_v) option(output) nomem
  TEXT      tx_h14 325 54 660 ., label("what to produce (default network)")
  TEXT      tx_s_basis 10 75 200 ., label("basis()")
  COMBOBOX  f_s_basis 215 73 170 ., dropdown contents(netlist) option(basis) nomem
  TEXT      tx_h15 395 75 590 ., label("start network (default: last network of the fit)")
  TEXT      tx_s_coef 10 96 200 ., label("coef()")
  EDIT      f_s_coef 215 94 110 ., option(coef) nomem
  TEXT      tx_h16 335 96 650 ., label("name of a Stata matrix with the coefficients")
  CHECKBOX  f_s_nosequential 10 115 200 ., label("nosequential") default(0) nomem
  TEXT      tx_h17 220 117 765 ., label("restart every draw from the start network")
  TEXT      tx_s_burnin 10 138 200 ., label("burnin()")
  EDIT      f_s_burnin 215 136 110 ., option(burnin) nomem
  TEXT      tx_s_interval 10 159 200 ., label("interval()")
  EDIT      f_s_interval 215 157 110 ., option(interval) nomem
  TEXT      tx_s_generate 10 180 200 ., label("generate()")
  EDIT      f_s_generate 215 178 110 ., option(generate) nomem
  TEXT      tx_h18 335 180 650 ., label("stub for the simulated networks")
  CHECKBOX  f_s_clear 10 199 200 ., label("clear") default(0) nomem
  TEXT      tx_h19 220 201 765 ., label("needed with output(edgelist)")
END

LIST netlist
BEGIN
	// filled in when the dialog opens (see PROGRAM initialize, _nwergm_dlgprep.ado)
END

LIST netlist_a
BEGIN
	// filled in when the dialog opens (see PROGRAM initialize, _nwergm_dlgprep.ado)
END

LIST fitlist
BEGIN
	// filled in when the dialog opens (see PROGRAM initialize, _nwergm_dlgprep.ado)
END

LIST l_which
BEGIN
	estat gof - goodness of fit
	estat mcmcdiag - MCMC diagnostics
	estat ic - information criteria
	nwergm simulate - draw networks from the fitted model
END

LIST l_which_v
BEGIN
	gof
	mcmcdiag
	ic
	simfit
END

LIST l_f_m_pvalue
BEGIN
	"(default)"
	0.10
	0.05
	0.025
	0.01
END

LIST l_f_m_pvalue_v
BEGIN
	""
	0.10
	0.05
	0.025
	0.01
END

LIST l_f_s_output
BEGIN
	"(default)"
	network
	stats
	edgelist
END

LIST l_f_s_output_v
BEGIN
	""
	network
	stats
	edgelist
END

PROGRAM initialize
BEGIN
	put "_nwdialog nwergm_estat"
	stata hidden immediate
END

PROGRAM command
BEGIN
	if main.cb_which.iseq("gof") {
		put "estat gof"
		beginoptions
			optionarg /asis gof.f_g_nsim
			optionarg /asis gof.f_g_seed
			optionarg /asis gof.f_g_burnin
			optionarg /asis gof.f_g_interval
			optionarg /asis gof.f_g_maxdeg
			optionarg /asis gof.f_g_maxdist
			optionarg /asis gof.f_g_name
			if gof.f_g_plot {
				put " plot"
			}
			if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree | ///
			gof.cx_gof_espartners | gof.cx_gof_dspartners | gof.cx_gof_distance | gof.cx_gof_triadcensus | gof.cx_gof_model | ///
			gof.cx_gof_dropmodel {
				put " gof("
				if gof.cx_gof_degree {
					put "degree"
				}
				if gof.cx_gof_idegree {
					if gof.cx_gof_degree {
						put " "
					}
					put "idegree"
				}
				if gof.cx_gof_odegree {
					if gof.cx_gof_degree | gof.cx_gof_idegree {
						put " "
					}
					put "odegree"
				}
				if gof.cx_gof_b1degree {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree {
						put " "
					}
					put "b1degree"
				}
				if gof.cx_gof_b2degree {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree {
						put " "
					}
					put "b2degree"
				}
				if gof.cx_gof_espartners {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree {
						put " "
					}
					put "espartners"
				}
				if gof.cx_gof_dspartners {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree | gof.cx_gof_espartners {
						put " "
					}
					put "dspartners"
				}
				if gof.cx_gof_distance {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree | gof.cx_gof_espartners | gof.cx_gof_dspartners {
						put " "
					}
					put "distance"
				}
				if gof.cx_gof_triadcensus {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree | gof.cx_gof_espartners | gof.cx_gof_dspartners | gof.cx_gof_distance {
						put " "
					}
					put "triadcensus"
				}
				if gof.cx_gof_model {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree | gof.cx_gof_espartners | gof.cx_gof_dspartners | gof.cx_gof_distance | gof.cx_gof_triadcensus {
						put " "
					}
					put "model"
				}
				if gof.cx_gof_dropmodel {
					if gof.cx_gof_degree | gof.cx_gof_idegree | gof.cx_gof_odegree | gof.cx_gof_b1degree | gof.cx_gof_b2degree | gof.cx_gof_espartners | gof.cx_gof_dspartners | gof.cx_gof_distance | gof.cx_gof_triadcensus | gof.cx_gof_model {
						put " "
					}
					put "-model"
				}
				put ")"
			}
		endoptions
	}
	if main.cb_which.iseq("mcmcdiag") {
		put "estat mcmcdiag"
		beginoptions
			optionarg /asis mcmcdiag.f_m_pvalue
			optionarg /asis mcmcdiag.f_m_eps
			optionarg /asis mcmcdiag.f_m_name
			if mcmcdiag.f_m_plot {
				put " plot"
			}
		endoptions
	}
	if main.cb_which.iseq("simfit") {
		put "nwergm simulate"
		beginoptions
			optionarg /asis simfit.f_s_nsim
			optionarg /asis simfit.f_s_seed
			optionarg /asis simfit.f_s_output
			optionarg /asis simfit.f_s_basis
			optionarg /asis simfit.f_s_coef
			if simfit.f_s_nosequential {
				put " nosequential"
			}
			optionarg /asis simfit.f_s_burnin
			optionarg /asis simfit.f_s_interval
			optionarg /asis simfit.f_s_generate
			if simfit.f_s_clear {
				put " clear"
			}
		endoptions
	}
	if main.cb_which.iseq("ic") {
		put "estat ic"
	}
	stata
END
