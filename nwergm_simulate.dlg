PROGRAM initialize
BEGIN
	put "_nwergm_dlgprep nwergm_simulate"
	stata hidden immediate
END

PROGRAM o_plain1
BEGIN
	if main.cx_edges {
		put " edges"
	}
	if main.cx_mutual {
		put " mutual"
	}
	if main.cx_triangle {
		put " triangle"
	}
	if main.cx_ctriple {
		put " ctriple"
	}
	if main.cx_transitiveties {
		put " transitiveties"
	}
	if main.cx_cyclicalties {
		put " cyclicalties"
	}
	if main.cx_concurrent {
		put " concurrent"
	}
	if main.cx_sender {
		put " sender"
	}
	if main.cx_receiver {
		put " receiver"
	}
	if deg.cx_gwdegree {
		require deg.f_gwdegree
		optionarg /asis deg.f_gwdegree
	}
	if deg.cx_gwodegree {
		require deg.f_gwodegree
		optionarg /asis deg.f_gwodegree
	}
	if deg.cx_gwidegree {
		require deg.f_gwidegree
		optionarg /asis deg.f_gwidegree
	}
	if deg.cx_degree {
		require deg.f_degree
		optionarg /asis deg.f_degree
	}
	if deg.cx_odegree {
		require deg.f_odegree
		optionarg /asis deg.f_odegree
	}
	if deg.cx_idegree {
		require deg.f_idegree
		optionarg /asis deg.f_idegree
	}
	if deg.cx_kstar {
		require deg.f_kstar
		optionarg /asis deg.f_kstar
	}
	if deg.cx_ostar {
		require deg.f_ostar
		optionarg /asis deg.f_ostar
	}
	if deg.cx_istar {
		require deg.f_istar
		optionarg /asis deg.f_istar
	}
	if deg.cx_degrange {
		require deg.f_degrange
		optionarg /asis deg.f_degrange
		if deg.f_degrange_to {
			optionarg /asis deg.f_degrange_to
		}
	}
	if deg.cx_odegrange {
		require deg.f_odegrange
		optionarg /asis deg.f_odegrange
		if deg.f_odegrange_to {
			optionarg /asis deg.f_odegrange_to
		}
	}
	if deg.cx_idegrange {
		require deg.f_idegrange
		optionarg /asis deg.f_idegrange
		if deg.f_idegrange_to {
			optionarg /asis deg.f_idegrange_to
		}
	}
	if tri.cx_esp {
		require tri.f_esp
		optionarg /asis tri.f_esp
	}
	if tri.cx_dsp {
		require tri.f_dsp
		optionarg /asis tri.f_dsp
	}
	optionarg /asis tri.f_type
	if tri.cx_gwesp {
		require tri.f_gwesp
		optionarg /asis tri.f_gwesp
	}
	if tri.cx_gwdsp {
		require tri.f_gwdsp
		optionarg /asis tri.f_gwdsp
	}
END

PROGRAM o_plain2
BEGIN
	if tri.cx_gwnsp {
		require tri.f_gwnsp
		optionarg /asis tri.f_gwnsp
	}
	if cov.cx_nodecov {
		require cov.f_nodecov
		if !cov.f_nodecov_sub {
			optionarg /asis cov.f_nodecov
		}
		if cov.f_nodecov_sub {
			put " nodecov(" cov.f_nodecov ", " cov.f_nodecov_sub ")"
		}
	}
	if cov.cx_nodeicov {
		require cov.f_nodeicov
		if !cov.f_nodeicov_sub {
			optionarg /asis cov.f_nodeicov
		}
		if cov.f_nodeicov_sub {
			put " nodeicov(" cov.f_nodeicov ", " cov.f_nodeicov_sub ")"
		}
	}
	if cov.cx_nodeocov {
		require cov.f_nodeocov
		if !cov.f_nodeocov_sub {
			optionarg /asis cov.f_nodeocov
		}
		if cov.f_nodeocov_sub {
			put " nodeocov(" cov.f_nodeocov ", " cov.f_nodeocov_sub ")"
		}
	}
	if cov.cx_nodefactor {
		require cov.f_nodefactor
		if !cov.f_nodefactor_sub {
			optionarg /asis cov.f_nodefactor
		}
		if cov.f_nodefactor_sub {
			put " nodefactor(" cov.f_nodefactor ", " cov.f_nodefactor_sub ")"
		}
	}
	if cov.cx_nodeofactor {
		require cov.f_nodeofactor
		if !cov.f_nodeofactor_sub {
			optionarg /asis cov.f_nodeofactor
		}
		if cov.f_nodeofactor_sub {
			put " nodeofactor(" cov.f_nodeofactor ", " cov.f_nodeofactor_sub ")"
		}
	}
	if cov.cx_nodeifactor {
		require cov.f_nodeifactor
		if !cov.f_nodeifactor_sub {
			optionarg /asis cov.f_nodeifactor
		}
		if cov.f_nodeifactor_sub {
			put " nodeifactor(" cov.f_nodeifactor ", " cov.f_nodeifactor_sub ")"
		}
	}
	if cov.cx_nodematch {
		require cov.f_nodematch
		if !cov.f_nodematch_sub {
			optionarg /asis cov.f_nodematch
		}
		if cov.f_nodematch_sub {
			put " nodematch(" cov.f_nodematch ", " cov.f_nodematch_sub ")"
		}
	}
	if cov.cx_nodematchdiff {
		require cov.f_nodematchdiff
		if !cov.f_nodematchdiff_sub {
			optionarg /asis cov.f_nodematchdiff
		}
		if cov.f_nodematchdiff_sub {
