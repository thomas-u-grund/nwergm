				}
				put "diff"
			}
			put ")"
		}
	}
	if tri.cx_s_ctriple {
		put " ctriple"
		if tri.f_s_ctriple_attr | tri.f_s_ctriple_diff {
			put "("
			if tri.f_s_ctriple_attr {
				put "attr=" tri.f_s_ctriple_attr
			}
			if tri.f_s_ctriple_diff {
				if tri.f_s_ctriple_attr {
					put " "
				}
				put "diff"
			}
			put ")"
		}
	}
	if tri.cx_cycle {
		put " cycle"
		if tri.f_cycle_k | tri.f_cycle_semi {
			put "("
			if tri.f_cycle_k {
				put "k=" tri.f_cycle_k
			}
			if tri.f_cycle_semi {
				if tri.f_cycle_k {
					put " "
				}
				put "semi"
			}
			put ")"
		}
	}
END

PROGRAM o_struct4
BEGIN
	if tri.cx_threetrail {
		put " threetrail"
		if tri.f_threetrail_keep {
			put "("
			if tri.f_threetrail_keep {
				put "keep=" tri.f_threetrail_keep
			}
			put ")"
		}
	}
	if tri.cx_balance {
		put " balance"
	}
	if tri.cx_triadcensus {
		put " triadcensus"
		if tri.f_triadcensus_levels {
			put "("
			if tri.f_triadcensus_levels {
				put "levels=" tri.f_triadcensus_levels
			}
			put ")"
		}
	}
	if tri.cx_tripercent {
		put " tripercent"
		if tri.f_tripercent_attr | tri.f_tripercent_diff {
			put "("
			if tri.f_tripercent_attr {
				put "attr=" tri.f_tripercent_attr
			}
			if tri.f_tripercent_diff {
				if tri.f_tripercent_attr {
					put " "
				}
				put "diff"
			}
			put ")"
		}
	}
	if tri.cx_nearsimmelian {
		put " nearsimmelian"
	}
	if tri.cx_simmelian {
		put " simmelian"
	}
	if tri.cx_simmelianties {
		put " simmelianties"
	}
	if tri.cx_asymmetric {
		put " asymmetric"
		if tri.f_asymmetric_attr | tri.f_asymmetric_diff {
			put "("
			if tri.f_asymmetric_attr {
				put "attr=" tri.f_asymmetric_attr
			}
			if tri.f_asymmetric_diff {
				if tri.f_asymmetric_attr {
					put " "
				}
				put "diff"
			}
			put ")"
		}
	}
	if tri.cx_s_mutual {
		put " mutual"
		if tri.f_s_mutual_same | tri.f_s_mutual_diff | tri.f_s_mutual_by {
			put "("
			if tri.f_s_mutual_same {
				put "same=" tri.f_s_mutual_same
			}
			if tri.f_s_mutual_diff {
				if tri.f_s_mutual_same {
					put " "
				}
				put "diff"
			}
			if tri.f_s_mutual_by {
				if tri.f_s_mutual_same | tri.f_s_mutual_diff {
					put " "
				}
				put "by=" tri.f_s_mutual_by
			}
			put ")"
		}
	}
	if tri.cx_localtriangle {
		put " localtriangle"
		require tri.f_localtriangle_x
		if tri.f_localtriangle_x {
			put "("
			if tri.f_localtriangle_x {
				put "x=" tri.f_localtriangle_x
			}
			put ")"
		}
	}
	if tri.cx_opentriad {
		put " opentriad"
	}
END

PROGRAM o_struct5
BEGIN
	if tri.cx_nsp {
		put " nsp"
		if tri.f_nsp_d | tri.f_nsp_type.isneq("") {
			put "("
			if tri.f_nsp_d {
				put "d=" tri.f_nsp_d
			}
			if tri.f_nsp_type.isneq("") {
				if tri.f_nsp_d {
					put " "
				}
				put "type=" tri.f_nsp_type
			}
			put ")"
		}
	}
	if tri.cx_s_altkstar {
		put " altkstar"
		if tri.f_s_altkstar_lambda | tri.f_s_altkstar_fixed {
