  CHECKBOX  cx_concurrent 10 316 190 ., label("concurrent") default(0) nomem
  TEXT      tx_h7 208 318 777 ., label("undirected only (degree 2 or more)")
  TEXT      tx_s304_main 10 339 960 ., label("== Node-level effects ==")
  CHECKBOX  cx_sender 10 358 190 ., label("sender") default(0) nomem
  TEXT      tx_h8 208 360 777 ., label("directed only; one coefficient per node (out-degree)")
  CHECKBOX  cx_receiver 10 379 190 ., label("receiver") default(0) nomem
  TEXT      tx_h9 208 381 777 ., label("directed only; one coefficient per node (in-degree)")
  TEXT      tx_s367_main 10 402 960 ., label("== Simple structural() terms (need the native plugin) ==")
  CHECKBOX  cx_density 10 421 190 ., label("density") default(0) nomem
  TEXT      tx_h10 208 423 777 ., label("structural(); collinear with edges")
  CHECKBOX  cx_meandeg 10 43 190 ., label("meandeg") default(0) nomem
  TEXT      tx_h11 208 45 777 ., label("structural(); collinear with edges")
  CHECKBOX  cx_twopath 10 64 190 ., label("twopath") default(0) nomem
  TEXT      tx_h12 208 66 777 ., label("structural(): two-paths")
  CHECKBOX  cx_isolates 10 85 190 ., label("isolates") default(0) nomem
