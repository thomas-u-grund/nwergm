				put "lambda=" tri.f_s_altkstar_lambda
			}
			if tri.f_s_altkstar_fixed {
				if tri.f_s_altkstar_lambda {
					put " "
				}
				put "fixed"
			}
			put ")"
		}
	}
END

PROGRAM o_con_1
BEGIN
	if space.f_constraints_extra {
		put space.f_constraints_extra
	}
END

PROGRAM command
BEGIN
	require simctl.f_sim_nodes
	put "nwergm simulate " simctl.f_sim_nodes
	beginoptions
		put /program o_plain1
		put /program o_plain2
		put /program o_plain3
		put /program o_plain4
		put /program o_plain5
		if main.cx_density | main.cx_meandeg | main.cx_twopath | main.cx_isolates | main.cx_isolatededges | deg.cx_s_degree | ///
			deg.cx_s_odegree | deg.cx_s_idegree | deg.cx_s_degrange | deg.cx_s_odegrange | deg.cx_s_idegrange | deg.cx_s_kstar | ///
			deg.cx_s_ostar | deg.cx_s_istar | deg.cx_s_concurrent | deg.cx_concurrentties | deg.cx_degree1_5 | deg.cx_odegree1_5 | ///
			deg.cx_idegree1_5 | deg.cx_degcrossprod | deg.cx_degcor | deg.cx_m2star | tri.cx_s_triangle | tri.cx_transitive | ///
			tri.cx_intransitive | tri.cx_ttriple | tri.cx_s_ctriple | tri.cx_cycle | tri.cx_threetrail | tri.cx_balance | ///
			tri.cx_triadcensus | tri.cx_tripercent | tri.cx_nearsimmelian | tri.cx_simmelian | tri.cx_simmelianties | ///
			tri.cx_asymmetric | tri.cx_s_mutual | tri.cx_localtriangle | tri.cx_opentriad | tri.cx_nsp | tri.cx_s_altkstar {
			put " structural("
			put /program o_struct1
			put /program o_struct2
			put /program o_struct3
			put /program o_struct4
			put /program o_struct5
			put ")"
		}
		if space.f_constraints_extra {
			put " constraints("
			put /program o_con_1
			put ")"
		}
	endoptions
	stata
END
