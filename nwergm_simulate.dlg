DIALOG main, label("nwergm simulate - draw networks from an ERGM") tabtitle("Basic")
BEGIN
  TEXT      tx_sec_main 10 12 70 ., label("Section:")
  COMBOBOX  cb_sec_main 85 10 380 ., dropdownlist contents(l_sec_main) onselchangelist(l_sec_main_a) nomem
  TEXT      tx_n10_main 10 45 960 ., label("nwergm simulate draws networks from a model with fixed coefficients (theta). The node variables used by a term must")
  TEXT      tx_n31_main 10 66 960 ., label("already be in the data (one row per node). The number of nodes, theta() and the other settings are on the last tab.")
  TEXT      tx_s52_main 10 87 960 ., label("== Required term ==")
  CHECKBOX  cx_edges 10 106 190 ., label("edges") default(1) nomem
  TEXT      tx_h1 208 108 777 ., label("required (intercept); may be omitted only with density or meandeg")
  TEXT      tx_s94_main 10 129 960 ., label("== Reciprocity, triangles, concurrency ==")
  CHECKBOX  cx_mutual 10 148 190 ., label("mutual") default(0) nomem
  TEXT      tx_h2 208 150 777 ., label("directed only")
  CHECKBOX  cx_triangle 10 169 190 ., label("triangle") default(0) nomem
  TEXT      tx_h3 208 171 777 ., label("undirected only (R: triangle)")
  CHECKBOX  cx_ctriple 10 190 190 ., label("ctriple") default(0) nomem
  TEXT      tx_h4 208 192 777 ., label("directed only (cyclic triples)")
  CHECKBOX  cx_transitiveties 10 211 190 ., label("transitiveties") default(0) nomem
  TEXT      tx_h5 208 213 777 ., label("directed only")
  CHECKBOX  cx_cyclicalties 10 232 190 ., label("cyclicalties") default(0) nomem
  TEXT      tx_h6 208 234 777 ., label("directed only")
  CHECKBOX  cx_concurrent 10 253 190 ., label("concurrent") default(0) nomem
  TEXT      tx_h7 208 255 777 ., label("undirected only (degree 2 or more)")
  TEXT      tx_s241_main 10 276 960 ., label("== Node-level effects ==")
  CHECKBOX  cx_sender 10 295 190 ., label("sender") default(0) nomem
  TEXT      tx_h8 208 297 777 ., label("directed only; one coefficient per node (out-degree)")
  CHECKBOX  cx_receiver 10 316 190 ., label("receiver") default(0) nomem
  TEXT      tx_h9 208 318 777 ., label("directed only; one coefficient per node (in-degree)")
  TEXT      tx_s304_main 10 339 960 ., label("== Simple structural() terms (need the native plugin) ==")
  CHECKBOX  cx_density 10 358 190 ., label("density") default(0) nomem
  TEXT      tx_h10 208 360 777 ., label("structural(); collinear with edges")
  CHECKBOX  cx_meandeg 10 379 190 ., label("meandeg") default(0) nomem
  TEXT      tx_h11 208 381 777 ., label("structural(); collinear with edges")
  CHECKBOX  cx_twopath 10 400 190 ., label("twopath") default(0) nomem
  TEXT      tx_h12 208 402 777 ., label("structural(): two-paths")
  CHECKBOX  cx_isolates 10 421 190 ., label("isolates") default(0) nomem
  TEXT      tx_h13 208 423 777 ., label("structural(): isolated nodes")
  CHECKBOX  cx_isolatededges 10 43 190 ., label("isolatededges") default(0) nomem
  TEXT      tx_h14 208 45 777 ., label("structural(), undirected only")
END

