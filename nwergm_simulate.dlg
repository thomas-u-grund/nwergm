PROGRAM initialize
BEGIN
	put "_nwdialog nwergm_simulate"
	stata hidden immediate
END

PROGRAM o_plain1
BEGIN
	if main.cx_edges {
		put " edges"
	}
	if main.cx_mutual {
		put " mutual"
	}
	if main.cx_triangle {
		put " triangle"
	}
	if main.cx_ctriple {
		put " ctriple"
	}
	if main.cx_transitiveties {
		put " transitiveties"
	}
	if main.cx_cyclicalties {
		put " cyclicalties"
	}
	if main.cx_concurrent {
		put " concurrent"
	}
	if main.cx_sender {
		put " sender"
	}
