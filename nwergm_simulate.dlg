DIALOG main, label("nwergm simulate - draw networks from an ERGM") tabtitle("Basic")
BEGIN
  TEXT      tx_sec_main 10 12 70 ., label("Section:")
  COMBOBOX  cb_sec_main 85 10 380 ., dropdownlist contents(l_sec_main) onselchangelist(l_sec_main_a) nomem
  CHECKBOX  cx_fit 10 43 560 ., label("Use the model of the last nwergm fit (greys out the model fields)") default(0) onclickon(program fit_changed) onclickoff(program fit_changed) nomem
  COMBOBOX  cb_fitflag 600 43 60 ., dropdownlist contents(fitlist) values(fitlist) nomem
  TEXT      tx_n31_main 10 66 960 ., label("Untick it to specify the model yourself: number of nodes, terms and theta() (nwergm simulate #nodes, edges ... theta()). The other tabs hold the terms.")
  TEXT      tx_type2 10 87 120 ., label("Network type:")
  COMBOBOX  cb_type 140 85 110 ., dropdownlist contents(l_type) values(l_type_v) onselchange(program type_apply) nomem
  TEXT      tx_n73_main 10 108 960 ., label("nwergm simulate draws networks from a model with fixed coefficients (theta). The node variables used by a term must")
  TEXT      tx_n94_main 10 129 960 ., label("already be in the data (one row per node). The number of nodes, theta() and the other settings are on the last tab.")
  TEXT      tx_s115_main 10 150 960 ., label("== Required term ==")
  CHECKBOX  cx_edges 10 169 190 ., label("edges") default(1) nomem
  TEXT      tx_h1 208 171 777 ., label("required (intercept); may be omitted only with density or meandeg")
  TEXT      tx_s157_main 10 192 960 ., label("== Reciprocity, triangles, concurrency ==")
  CHECKBOX  cx_mutual 10 211 190 ., label("mutual") default(0) nomem
  TEXT      tx_h2 208 213 777 ., label("directed only")
  CHECKBOX  cx_triangle 10 232 190 ., label("triangle") default(0) nomem
  TEXT      tx_h3 208 234 777 ., label("undirected only (R: triangle)")
  CHECKBOX  cx_ctriple 10 253 190 ., label("ctriple") default(0) nomem
  TEXT      tx_h4 208 255 777 ., label("directed only (cyclic triples)")
  CHECKBOX  cx_transitiveties 10 274 190 ., label("transitiveties") default(0) nomem
