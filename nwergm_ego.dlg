/* nwergm_ego.dlg - written by hand (the other nwergm dialogs are generated by dlg/gen_dialogs.py); nwergm ego for egocentrically sampled data. */
VERSION 14.0
SYNCHRONOUS_ONLY

INCLUDE _std_xxwide
DEFINE _dlgwd 1000
DEFINE _dlght 400
INCLUDE header

HELP hlp1, view("help nwergm_ego")
RESET res1

DIALOG main, label("nwergm ego - ERGM for egocentrically sampled data (R: ergm.ego)") tabtitle("Data")
BEGIN
  TEXT      tx_n1 10 8 960 ., label("The data in memory are the egos (one row per ego). The alters are in a second frame (one row per alter).")
  TEXT      tx_egoid 10 36 200 ., label("egoid()")
  VARNAME   vn_egoid 215 34 200 ., option(egoid) nomem
  TEXT      tx_h1 425 36 560 ., label("variable that identifies the egos")
  TEXT      tx_alters 10 57 200 ., label("alters()")
  EDIT      ed_alters 215 55 200 ., option(alters) nomem
  TEXT      tx_h2 425 57 560 ., label("name of the frame with the alters")
  TEXT      tx_alteregoid 10 78 200 ., label("alteregoid()")
  EDIT      ed_alteregoid 215 76 200 ., option(alteregoid) nomem
  TEXT      tx_h3 425 78 560 ., label("variable of the alter frame with the ego identifier; default: the name of egoid()")
  TEXT      tx_egodegree 10 99 200 ., label("egodegree()")
  VARNAME   vn_egodegree 215 97 200 ., option(egodegree) nomem
  TEXT      tx_h4 425 99 560 ., label("number of alters of each ego, instead of alters() (alters unobserved)")
  TEXT      tx_weights 10 120 200 ., label("weights()")
  VARNAME   vn_weights 215 118 200 ., option(weights) nomem
  TEXT      tx_h5 425 120 560 ., label("sampling weights of the egos; default equal weights")
  TEXT      tx_popsize 10 141 200 ., label("popsize()")
  EDIT      ed_popsize 215 139 110 ., option(popsize) nomem
  TEXT      tx_h6 335 141 650 ., label("number of nodes of the population; default 1 (coefficients per person), 0 = no size adjustment")
  TEXT      tx_ppopsize 10 162 200 ., label("ppopsize()")
  EDIT      ed_ppopsize 215 160 110 ., option(ppopsize) nomem
  TEXT      tx_h7 335 162 650 ., label("size of the pseudopopulation: auto (default), samp, pop or a number")
  TEXT      tx_ppopmul 10 183 200 ., label("ppopmul()")
  EDIT      ed_ppopmul 215 181 110 ., option(ppopmul) nomem
  TEXT      tx_h8 335 183 650 ., label("multiplier of the pseudopopulation size; default 1")
  TEXT      tx_ppopwt 10 204 200 ., label("ppopwt()")
  COMBOBOX  cb_ppopwt 215 202 110 ., dropdownlist contents(l_ppopwt) values(l_ppopwt_v) option(ppopwt) nomem
  TEXT      tx_h9 335 204 650 ., label("how the egos are copied into the pseudopopulation: round (default) or sample")
END

DIALOG terms, tabtitle("Terms")
BEGIN
  CHECKBOX  cx_edges 10 12 200 ., label("edges") default(1) nomem
  TEXT      tx_h10 220 14 765 ., label("required (every model has an edges term)")
  TEXT      tx_degree 10 33 200 ., label("degree()")
  EDIT      ed_degree 215 31 200 ., option(degree) nomem
  TEXT      tx_h11 425 33 560 ., label("degrees, e.g. 1/3 or 1 2 3")
  TEXT      tx_degrange 10 54 200 ., label("degrange()")
  EDIT      ed_degrange 215 52 200 ., option(degrange) nomem
  TEXT      tx_h12 425 54 560 ., label("lower limits of degree ranges")
  TEXT      tx_degrangeto 10 75 200 ., label("degrangeto()")
  EDIT      ed_degrangeto 215 73 200 ., option(degrangeto) nomem
  TEXT      tx_h13 425 75 560 ., label("upper limits (not included); default: no upper limit")
  CHECKBOX  cx_concurrent 10 94 200 ., label("concurrent") default(0) nomem
  TEXT      tx_h14 220 96 765 ., label("number of egos with two or more alters")
  TEXT      tx_nodefactor 10 117 200 ., label("nodefactor()")
  VARLIST   vl_nodefactor 215 115 200 ., option(nodefactor) nomem
  TEXT      tx_h15 425 117 560 ., label("categorical attributes: main effects of the levels")
  TEXT      tx_nodematch 10 138 200 ., label("nodematch()")
  VARLIST   vl_nodematch 215 136 200 ., option(nodematch) nomem
  TEXT      tx_h16 425 138 560 ., label("homophily on categorical attributes (needs the attribute of the alters)")
  TEXT      tx_nodematchdiff 10 159 200 ., label("nodematchdiff()")
  VARLIST   vl_nodematchdiff 215 157 200 ., option(nodematchdiff) nomem
  TEXT      tx_h17 425 159 560 ., label("homophily by level")
  TEXT      tx_nodecov 10 180 200 ., label("nodecov()")
  VARLIST   vl_nodecov 215 178 200 ., option(nodecov) nomem
  TEXT      tx_h18 425 180 560 ., label("numeric attributes: main effects")
  TEXT      tx_absdist 10 201 200 ., label("absdist()")
  VARLIST   vl_absdist 215 199 200 ., option(absdist) nomem
  TEXT      tx_h19 425 201 560 ., label("absolute difference of numeric attributes (needs the attribute of the alters)")
END

DIALOG mcmc, tabtitle("MCMC")
BEGIN
  TEXT      tx_seed 10 12 200 ., label("seed()")
  EDIT      ed_seed 215 10 110 ., option(seed) nomem
  TEXT      tx_h20 335 12 650 ., label("random-number seed (pseudopopulation and sampler)")
  TEXT      tx_interval 10 33 200 ., label("mcmcinterval()")
  EDIT      ed_interval 215 31 110 ., option(mcmcinterval) nomem
  TEXT      tx_h21 335 33 650 ., label("default 1024")
  TEXT      tx_burnin 10 54 200 ., label("mcmcburnin()")
  EDIT      ed_burnin 215 52 110 ., option(mcmcburnin) nomem
  TEXT      tx_h22 335 54 650 ., label("default 16 times the interval")
  TEXT      tx_samplesize 10 75 200 ., label("mcmcsamplesize()")
  EDIT      ed_samplesize 215 73 110 ., option(mcmcsamplesize) nomem
  TEXT      tx_h23 335 75 650 ., label("fixed sample size (default: adaptive)")
  TEXT      tx_iterations 10 96 200 ., label("mcmleiterations()")
  EDIT      ed_iterations 215 94 110 ., option(mcmleiterations) nomem
  TEXT      tx_h24 335 96 650 ., label("maximum number of iterations; default 60")
  TEXT      tx_effsize 10 117 200 ., label("mcmleeffectivesize()")
  EDIT      ed_effsize 215 115 110 ., option(mcmleeffectivesize) nomem
  TEXT      tx_h25 335 117 650 ., label("target effective sample size; default 64")
  CHECKBOX  cx_nonative 10 136 200 ., label("nonative") default(0) nomem
  TEXT      tx_h26 220 138 765 ., label("do not use the native plugin (slow)")
  CHECKBOX  cx_verbose 10 157 200 ., label("verbose") default(0) nomem
  TEXT      tx_h27 220 159 765 ., label("print the progress of the iterations")
END

LIST l_ppopwt
BEGIN
	"(default)"
	round
	sample
END

LIST l_ppopwt_v
BEGIN
	""
	round
	sample
END

PROGRAM command
BEGIN
	put "nwergm ego"
	beginoptions
		if terms.cx_edges {
			put " edges"
		}
		optionarg terms.ed_degree
		optionarg terms.ed_degrange
		optionarg terms.ed_degrangeto
		if terms.cx_concurrent {
			put " concurrent"
		}
		optionarg terms.vl_nodefactor
		optionarg terms.vl_nodematch
		optionarg terms.vl_nodematchdiff
		optionarg terms.vl_nodecov
		optionarg terms.vl_absdist
		optionarg main.vn_egoid
		optionarg main.ed_alters
		optionarg main.ed_alteregoid
		optionarg main.vn_egodegree
		optionarg main.vn_weights
		optionarg main.ed_popsize
		optionarg main.ed_ppopsize
		optionarg main.ed_ppopmul
		optionarg main.cb_ppopwt
		optionarg mcmc.ed_seed
		optionarg mcmc.ed_interval
		optionarg mcmc.ed_burnin
		optionarg mcmc.ed_samplesize
		optionarg mcmc.ed_iterations
		optionarg mcmc.ed_effsize
		if mcmc.cx_nonative {
			put " nonative"
		}
		if mcmc.cx_verbose {
			put " verbose"
		}
	endoptions
	stata
END
